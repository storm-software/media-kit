{
  "extends": "@storm-software/workspace-tools/config/recommended.json",
  "release": {
    "groups": {
      "packages": {
        "projects": ["packages/*"],
        "projectsRelationship": "independent"
      }
    }
  },
  "plugins": [
    {
      "name": "@storm-software/workspace-tools/plugins/typescript",
      "options": {
        "enableEslint": false
      }
    },
    "@storm-software/workspace-tools/plugins/typescript/untyped",
    "@storm-software/workspace-tools/plugins/typescript/tsup"
  ],
  "analytics": false
}
