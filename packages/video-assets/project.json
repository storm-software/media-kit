{
  "name": "video-assets",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/video-assets/src",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec rimraf dist/packages/video-assets",
          "pnpm exec rimraf packages/video-assets/dist"
        ]
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "remotion preview src/index.tsx",
        "cwd": "{projectRoot}"
      }
    },
    "build-storm-software": {
      "cache": true,
      "inputs": [
        "{projectRoot}/src/storm-software",
        "{projectRoot}/src/components",
        "{projectRoot}/src/types",
        "{projectRoot}/src/utilities",
        "{projectRoot}/src/style.css",
        "{projectRoot}/scripts"
      ],
      "outputs": ["{projectRoot}/dist/optimized/storm-software"],
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "clean"],
      "options": {
        "command": "tsx scripts/build.ts storm-software",
        "cwd": "{projectRoot}"
      }
    },
    "build-cyclone-ui": {
      "cache": true,
      "inputs": [
        "{projectRoot}/src/cyclone-ui",
        "{projectRoot}/src/components",
        "{projectRoot}/src/types",
        "{projectRoot}/src/utilities",
        "{projectRoot}/src/style.css",
        "{projectRoot}/scripts"
      ],
      "outputs": ["{projectRoot}/dist/optimized/cyclone-ui"],
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "clean"],
      "options": {
        "command": "tsx scripts/build.ts cyclone-ui",
        "cwd": "{projectRoot}"
      }
    },
    "build-powerlines": {
      "cache": true,
      "inputs": [
        "{projectRoot}/src/powerlines",
        "{projectRoot}/src/components",
        "{projectRoot}/src/types",
        "{projectRoot}/src/utilities",
        "{projectRoot}/src/style.css",
        "{projectRoot}/scripts"
      ],
      "outputs": ["{projectRoot}/dist/optimized/powerlines"],
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "clean"],
      "options": {
        "command": "tsx scripts/build.ts powerlines",
        "cwd": "{projectRoot}"
      }
    },
    "build-power-plant": {
      "cache": true,
      "inputs": [
        "{projectRoot}/src/power-plant",
        "{projectRoot}/src/components",
        "{projectRoot}/src/types",
        "{projectRoot}/src/utilities",
        "{projectRoot}/src/style.css",
        "{projectRoot}/scripts"
      ],
      "outputs": ["{projectRoot}/dist/optimized/power-plant"],
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "clean"],
