      ],
      "outputs": ["{projectRoot}/dist/optimized/questgiver"],
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "clean"],
      "options": {
        "command": "tsx scripts/build.ts questgiver",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "cache": false,
      "inputs": ["{projectRoot}/dist"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "executor": "nx:run-commands",
      "dependsOn": [
        "clean",
        "typecheck",
        "build-storm-software",
        "build-cyclone-ui",
        "build-powerlines",
        "build-power-plant",
        "build-acidic",
        "build-shell-shock",
        "build-sourcebook",
        "build-earthquake",
        "build-stryke",
        "build-may-i",
        "build-telepathic",
        "build-razorwind",
        "build-questgiver"
      ],
      "options": {
        "commands": [
          "pnpm copyfiles LICENSE dist/packages/video-assets",
          "pnpm copyfiles --up=2 ./packages/video-assets/*.md ./packages/video-assets/package.json dist/packages/video-assets",
          "pnpm copyfiles --up=4 \"./packages/video-assets/dist/optimized/*/media/*\" ./dist/packages/video-assets"
        ]
      }
    },
    "nx-release-publish": {
      "executor": "@storm-software/cloudflare-tools:r2-upload-publish",
      "options": {
        "bucketId": "storm-public",
        "tag": "media-kit",
        "path": "dist/packages/video-assets"
      }
    }
  },
  "tags": ["platform:node"]
}
