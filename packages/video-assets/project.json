      "outputs": ["{projectRoot}/dist/optimized/acidic"],
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "clean"],
      "options": {
        "command": "tsx scripts/build.ts acidic",
        "cwd": "{projectRoot}"
      }
    },
    "build-shell-shock": {
