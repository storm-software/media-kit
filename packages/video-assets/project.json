      "inputs": [
        "{projectRoot}/src/stryke",
        "{projectRoot}/src/components",
        "{projectRoot}/src/types",
        "{projectRoot}/src/utilities",
        "{projectRoot}/src/style.css",
        "{projectRoot}/scripts"
      ],
      "outputs": ["{projectRoot}/dist/optimized/stryke"],
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "clean"],
      "options": {
        "command": "tsx scripts/build.ts stryke",
        "cwd": "{projectRoot}"
      }
    },
    "build-telepathic": {
      "cache": true,
      "inputs": [
        "{projectRoot}/src/telepathic",
